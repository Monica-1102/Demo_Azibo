{
  "name": "jigmesoft-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Jigmesoft (Azibo) demo: merchant flow enquiry -> pre-costing -> WIP -> order entry -> CAD, on Next.js + NestJS + PostgreSQL",
  "scripts": {
    "db:start": "node scripts/embedded-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "dev:server": "nest start --watch",
    "dev:web": "next dev src/web -p 3000",
    "dev": "concurrently -k -n db,api,web -c gray,blue,magenta \"npm:db:start\" \"wait-on tcp:127.0.0.1:5433 && npm run dev:server\" \"npm:dev:web\"",
    "build:server": "nest build",
    "build:web": "next build src/web",
    "build": "prisma generate && npm run build:web && npm run build:server",
    "vercel-build": "prisma generate && npm run build:web && npm run build:server",
    "db:app-role": "node scripts/db-app-role.mjs",
    "db:deploy": "prisma migrate deploy && node scripts/db-app-role.mjs && tsx prisma/seed.ts",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^5.29.3",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "helmet": "^8.3.0",
    "jspreadsheet-ce": "^4.15.0",
    "jsuites": "^5.13.5",
    "next": "^15.5.29",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "embedded-postgres": "^17.6.0-beta.15",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "wait-on": "^8.0.5"
  }
}

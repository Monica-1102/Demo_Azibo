# Copy to .env and change the secrets. Never commit .env.

# The app connects as a non-owner role so PostgreSQL row-level security applies to it.
# Hosted (Vercel): use the provider's POOLED endpoint and add ?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL="postgresql://azibo_app:change_me_app@127.0.0.1:5433/jigmesoft_demo"
# Migrations, the app-role script and the seed run as the owner role (DIRECT, not pooled; add ?sslmode=require when hosted).
DIRECT_DATABASE_URL="postgresql://postgres:change_me_owner@127.0.0.1:5433/jigmesoft_demo"

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change_me"
JWT_TTL_MINUTES=480

# NestJS port. In dev, Next.js runs on 3000 and proxies /api to this port.
PORT=4000

# Password given to every seeded demo user.
DEMO_PASSWORD="Demo@123"
